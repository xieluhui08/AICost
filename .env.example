# Generate three DIFFERENT random keys before starting. Never reuse the administrator key.
PORT=8080
ADMIN_KEY=
INGEST_KEY=
READ_KEY=
# Configure each provider with its official OpenAI-compatible endpoint and current model IDs.
# Repeat this group using QWEN, KIMI, DOUBAO, MINIMAX prefixes.
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_FALLBACK_MODEL=
DEEPSEEK_INPUT_CNY_PER_M=
DEEPSEEK_OUTPUT_CNY_PER_M=
DEEPSEEK_FALLBACK_INPUT_CNY_PER_M=
DEEPSEEK_FALLBACK_OUTPUT_CNY_PER_M=
FEISHU_WEBHOOK=
FEISHU_SECRET=
WECOM_WEBHOOK=


# Optional cache-hit input price; defaults to the normal input price.
DEEPSEEK_CACHE_INPUT_CNY_PER_M=
DEEPSEEK_FALLBACK_CACHE_INPUT_CNY_PER_M=

# Required only for saving integration settings from the web UI.
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep the same key when restarting/upgrading; back it up separately from the database.
CONFIG_ENCRYPTION_KEY=
